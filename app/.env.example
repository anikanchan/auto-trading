# Optional: override secrets via environment variables instead of macOS Keychain.
# Useful for CI, containers, or AWS deployment.
#
# Copy to .env and fill in (DO NOT COMMIT .env), or load these into your
# shell/container environment directly.
#
# Naming convention: AUTOTRADING_<SECRET_NAME_UPPER_WITH_UNDERSCORES>

AUTOTRADING_ALPACA_API_KEY_ID=
AUTOTRADING_ALPACA_API_SECRET_KEY=
AUTOTRADING_ALPACA_ACCOUNT_ID=

# Business (entity) account variants (used when alpaca.account_type == business)
AUTOTRADING_ALPACA_BUSINESS_API_KEY_ID=
AUTOTRADING_ALPACA_BUSINESS_API_SECRET_KEY=
AUTOTRADING_ALPACA_BUSINESS_ACCOUNT_ID=
AUTOTRADING_POLYGON_API_KEY=
AUTOTRADING_DASHBOARD_BASIC_AUTH_USER=
AUTOTRADING_DASHBOARD_BASIC_AUTH_PASSWORD=
AUTOTRADING_ALLOWED_PHONE_NUMBER=

# Twilio / WhatsApp (messaging.channel == whatsapp)
AUTOTRADING_TWILIO_ACCOUNT_SID=
AUTOTRADING_TWILIO_AUTH_TOKEN=
AUTOTRADING_TWILIO_WHATSAPP_NUMBER=

# Telegram (messaging.channel == telegram)
AUTOTRADING_TELEGRAM_BOT_TOKEN=
AUTOTRADING_TELEGRAM_CHAT_ID=
